# ── 飞书应用凭证（必填）──────────────────────────────────────────
# 在飞书开放平台 https://open.feishu.cn 创建应用后获取
FEISHU_APP_ID=your_app_id_here
FEISHU_APP_SECRET=your_app_secret_here

# ── 事件订阅配置（必填）──────────────────────────────────────────
# 在飞书开放平台 → 事件订阅页面获取
FEISHU_VERIFICATION_TOKEN=your_verification_token_here

# ── 事件加密密钥（可选）──────────────────────────────────────────
# 如果开启了事件加密，填写此字段；否则留空
FEISHU_ENCRYPT_KEY=

# ── 服务配置 ────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=9000

# ── PDF 字体配置（可选，默认自动检测操作系统）──────────────────
# Windows: C:\Windows\Fonts\msyh.ttc
# Linux (Render.com): /usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc
# FONT_PATH=
# FONT_BOLD_PATH=

# ── Render.com 部署说明 ───────────────────────────────────────
# 1. 将此项目推送到 GitHub
# 2. 在 render.com 创建 Web Service，关联此仓库
# 3. Build Command: bash build.sh
# 4. Start Command: uvicorn app:app --host 0.0.0.0 --port $PORT
# 5. 在 Environment 中添加以下变量:
#    FEISHU_APP_ID, FEISHU_APP_SECRET, FEISHU_VERIFICATION_TOKEN
# 6. 部署完成后，将 Render 分配的 URL + /webhook/event
#    填入飞书开放平台的事件订阅回调地址
